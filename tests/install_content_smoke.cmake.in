# Install/package content smoke test for trx_vanity.
# Generated by CMake; run with: cmake -P install_content_smoke.cmake

set(binary_dir "@CMAKE_BINARY_DIR@")
set(install_prefix "${binary_dir}/install-content-smoke")
set(installed_bin "${install_prefix}/bin/trx_vanity@CMAKE_EXECUTABLE_SUFFIX@")
set(installed_readme "${install_prefix}/README.md")
set(installed_user_guide "${install_prefix}/share/trx_vanity/docs/USER_GUIDE_zh.md")
set(installed_security "${install_prefix}/share/trx_vanity/docs/SECURITY_zh.md")
set(installed_packaging "${install_prefix}/share/trx_vanity/docs/PACKAGING_zh.md")
set(installed_kernel_dir "${install_prefix}/share/trx_vanity/kernel")

execute_process(
    COMMAND "@CMAKE_COMMAND@" -E rm -rf "${install_prefix}"
    RESULT_VARIABLE cleanup_result
)
if(NOT cleanup_result EQUAL 0)
    message(FATAL_ERROR "Failed to clean install prefix: ${install_prefix}")
endif()

execute_process(
    COMMAND "@CMAKE_COMMAND@" --install "${binary_dir}" --prefix "${install_prefix}"
    RESULT_VARIABLE install_result
)
if(NOT install_result EQUAL 0)
    message(FATAL_ERROR "cmake --install failed with code ${install_result}")
endif()

foreach(required_path
        "${installed_bin}"
        "${installed_readme}"
        "${installed_user_guide}"
        "${installed_security}"
        "${installed_packaging}")
    if(NOT EXISTS "${required_path}")
        message(FATAL_ERROR "Required install/package file missing: ${required_path}")
    endif()
endforeach()

if("@OpenCL_FOUND@" AND "@USE_OPENCL@")
    if(NOT EXISTS "${installed_kernel_dir}/vanity.cl")
        message(FATAL_ERROR "Installed vanity.cl not found under: ${installed_kernel_dir}")
    endif()
endif()

message(STATUS "Install/package content smoke passed: ${install_prefix}")
