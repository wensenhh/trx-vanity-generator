# Packaged ZIP runtime smoke test for trx_vanity on Windows.
# Generated by CMake; run with: cmake -P package_zip_runtime_smoke.cmake
#
# This test verifies:
#   1. ZIP package can be built
#   2. ZIP extracts correctly
#   3. Extracted binary runs in CPU mode
#   4. No private keys are leaked in output
#   5. Kernel files are present (if OpenCL enabled)

set(binary_dir "@CMAKE_BINARY_DIR@")
set(package_extract_root "${binary_dir}/package-zip-runtime-smoke")
set(runtime_cwd "${binary_dir}/package-zip-runtime-cwd")

# Build ZIP package
execute_process(
    COMMAND "@CMAKE_COMMAND@" --build "${binary_dir}" --target package --config Release
    RESULT_VARIABLE package_result
)
if(NOT package_result EQUAL 0)
    message(FATAL_ERROR "cmake --build --target package failed with code ${package_result}")
endif()

# Find ZIP package
file(GLOB zip_candidates "${binary_dir}/trx_vanity-*.zip")
if(NOT zip_candidates)
    message(FATAL_ERROR "No ZIP package found under: ${binary_dir}")
endif()
list(GET zip_candidates 0 zip_path)

# Clean and create directories
execute_process(
    COMMAND "@CMAKE_COMMAND@" -E rm -rf "${package_extract_root}" "${runtime_cwd}"
    RESULT_VARIABLE cleanup_result
)
if(NOT cleanup_result EQUAL 0)
    message(FATAL_ERROR "Failed to clean package smoke directories")
endif()
execute_process(
    COMMAND "@CMAKE_COMMAND@" -E make_directory "${package_extract_root}" "${runtime_cwd}"
    RESULT_VARIABLE mkdir_result
)
if(NOT mkdir_result EQUAL 0)
    message(FATAL_ERROR "Failed to create package smoke directories")
endif()

# Extract ZIP
execute_process(
    COMMAND "@CMAKE_COMMAND@" -E tar xf "${zip_path}"
    WORKING_DIRECTORY "${package_extract_root}"
    RESULT_VARIABLE extract_result
)
if(NOT extract_result EQUAL 0)
    message(FATAL_ERROR "Failed to extract ZIP package: ${zip_path}")
endif()

# Find extracted binary
file(GLOB extracted_bins "${package_extract_root}/*/bin/trx_vanity@CMAKE_EXECUTABLE_SUFFIX@")
if(NOT extracted_bins)
    message(FATAL_ERROR "Extracted trx_vanity binary not found under: ${package_extract_root}")
endif()
list(GET extracted_bins 0 packaged_bin)
get_filename_component(extracted_bin_dir "${packaged_bin}" DIRECTORY)
get_filename_component(extracted_root "${extracted_bin_dir}" DIRECTORY)
set(packaged_kernel_dir "${extracted_root}/share/trx_vanity/kernel")

# Verify kernel files (if OpenCL enabled)
if("@OpenCL_FOUND@" AND "@USE_OPENCL@")
    if(NOT EXISTS "${packaged_kernel_dir}/vanity.cl")
        message(FATAL_ERROR "Packaged vanity.cl not found under: ${packaged_kernel_dir}")
    endif()
endif()

# Verify no private key files or build artifacts are packaged
file(GLOB_RECURSE suspicious_files "${package_extract_root}/*private*" "${package_extract_root}/*.csv" "${package_extract_root}/*.env" "${package_extract_root}/*test_ecc*" "${package_extract_root}/*test_gpu*")
if(suspicious_files)
    foreach(f ${suspicious_files})
        message(WARNING "Potentially sensitive file in package: ${f}")
    endforeach()
endif()

# Run CPU smoke test (CPU mode must work without OpenCL)
execute_process(
    COMMAND "${packaged_bin}" prefix T --max-attempts 64 -t 1
    WORKING_DIRECTORY "${runtime_cwd}"
    RESULT_VARIABLE run_result
    OUTPUT_VARIABLE run_stdout
    ERROR_VARIABLE run_stderr
)
if(run_stdout MATCHES "Private Key:" OR run_stderr MATCHES "Private Key:")
    message(FATAL_ERROR "Packaged trx_vanity CPU smoke unexpectedly printed a private key")
endif()
if(NOT run_result EQUAL 0)
    message(FATAL_ERROR "Packaged trx_vanity CPU smoke failed with code ${run_result}")
endif()

# Test with space and Unicode in path (simulate by copying to such path)
set(space_test_dir "${binary_dir}/package space 中文测试")
execute_process(
    COMMAND "@CMAKE_COMMAND@" -E rm -rf "${space_test_dir}"
    RESULT_VARIABLE space_cleanup
)
execute_process(
    COMMAND "@CMAKE_COMMAND@" -E copy_directory "${extracted_root}" "${space_test_dir}"
    RESULT_VARIABLE space_copy
)
if(space_copy EQUAL 0)
    set(space_bin "${space_test_dir}/bin/trx_vanity@CMAKE_EXECUTABLE_SUFFIX@")
    if(EXISTS "${space_bin}")
        execute_process(
            COMMAND "${space_bin}" prefix T --max-attempts 64 -t 1
            WORKING_DIRECTORY "${space_test_dir}"
            RESULT_VARIABLE space_run_result
            OUTPUT_VARIABLE space_stdout
            ERROR_VARIABLE space_stderr
        )
        if(NOT space_run_result EQUAL 0)
            message(FATAL_ERROR "trx_vanity failed when installed in path with spaces/Unicode: ${space_run_result}")
        endif()
        message(STATUS "Space/Unicode path test passed: ${space_test_dir}")
    endif()
endif()

message(STATUS "Packaged ZIP runtime smoke passed: ${packaged_bin}")
